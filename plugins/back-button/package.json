{
  "name": "back-button",
  "version": "1.0.0",
  "description": "Floating back button for concept pages: returns to the note at its previous scroll position",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "back-button",
    "displayName": "Back Button",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "BackButton": {
        "displayName": "Back Button",
        "defaultPosition": "beforeBody",
        "defaultPriority": 1
      }
    }
  }
}
