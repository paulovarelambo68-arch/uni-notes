{
  "name": "focus-fullscreen",
  "version": "1.0.0",
  "description": "Browser fullscreen for focus (reader) mode: entering focus mode hides the browser toolbar and tabs, leaving restores them",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "focus-fullscreen",
    "displayName": "Focus Fullscreen",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "FocusFullscreen": {
        "displayName": "Focus Fullscreen",
        "defaultPosition": "beforeBody",
        "defaultPriority": 0
      }
    }
  }
}
