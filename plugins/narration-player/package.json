{
  "name": "narration-player",
  "version": "1.0.0",
  "description": "Audio narration player for notes with an audio track: jump by sentence or by section",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "narration-player",
